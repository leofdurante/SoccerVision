# ── SoccerVision environment configuration ──────────────────────────────
# Copy this file to `.env` (repo root, read by the backend) and fill in
# anything left blank. Never commit the real `.env`.

# --- Backend / FastAPI --------------------------------------------------

# SQLite by default for the hackathon MVP. Swap for a Postgres DSN
# (e.g. postgresql+psycopg://user:pass@host:5432/soccervision) later —
# the ORM layer (backend/app/models) does not assume SQLite.
DATABASE_URL=sqlite:///./data/soccervision.db

# Where uploaded videos and processed outputs are stored on local disk.
# Structured as plain local paths for the hackathon; swap for an
# Azure Blob / S3-backed storage service later without changing callers
# (see backend/app/services/storage.py).
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/processed

# --- Computer vision -----------------------------------------------------

# Ultralytics YOLOv8 nano, COCO-pretrained. Public model name; the weights
# file is downloaded automatically by the `ultralytics` package on first
# use (from Ultralytics' public GitHub release assets) and cached locally
# at this path. COCO class 0 ("person") is treated as "player" and class
# 32 ("sports ball") is treated as "ball" — see backend/app/cv/detector.py.
MODEL_PATH=yolov8n.pt

# How many frames per second of the source video to actually run
# detection/tracking on. Lower = faster processing, coarser trajectories.
PROCESSING_FPS=5

# Minimum YOLO confidence to keep a detection.
CONFIDENCE_THRESHOLD=0.45
# Inference resolution. 640 is ~3x faster than 1280 on CPU. Raise to 960 or
# 1280 if far-side players are being missed.
DETECTION_IMGSZ=640

# Hackathon-scale safety cap: max sampled frames actually processed per
# video, regardless of the source video's length. At 5 fps this is 60 seconds.
MAX_PROCESSED_FRAMES=300

# --- AI Tactical Analyst --------------------------------------------------
# Structured tactical stats (never raw video) are sent to an LLM to
# generate coaching-style commentary. This is optional: if AI_API_KEY is
# left blank, the app falls back to a deterministic, rule-based insight
# generator (see backend/app/services/ai_analyst.py) so the rest of the
# product is fully demoable without any external API key.
#
# Defaults below point at the public Anthropic Messages API. Get a key at
# https://console.anthropic.com — never commit it.
AI_API_KEY=
AI_API_BASE_URL=https://api.anthropic.com
# Required when AI_API_KEY is an identity-linked key — the API rejects
# those with a 400 unless the request names its workspace. Find it in the
# Console URL: platform.claude.com/workspaces/<AI_WORKSPACE_ID>/...
AI_WORKSPACE_ID=
MODEL_NAME=claude-opus-5

# --- CORS ------------------------------------------------------------------
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# --- Frontend --------------------------------------------------------------
# Also copy this to frontend/.env.local (Next.js does not read the repo
# root .env). See frontend/.env.example.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
